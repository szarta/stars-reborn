{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$id": "http://www.stars-reborn.com/schemas/player.json",
  "version": "0.0.3",
  "definitions": {
    "player-id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "player": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/player-id"
        },
        "race": {
          "$ref": "race.json#/definitions/race"
        },
        "homeworld": {
          "$ref": "universe.json#/definitions/space-object-id"
        },
        "annual-planet-resources": {
          "type": "integer",
          "minimum": 0
        },
        "is-ai": {
          "type": "boolean"
        },
        "parts-available": {
          "type": "array",
          "items": {
            "$ref": "tech.json#/definitions/parts-id"
          }
        },
        "starbase-hulls-available": {
          "type": "array",
          "items": {
            "$ref": "tech.json#/definitions/starbase-hull-id"
          }
        },
        "ship-hulls-available": {
          "type": "array",
          "items": {
            "$ref": "tech.json#/definitions/ship-hull-id"
          }
        },
        "ship-designs": {
          "description": "The player's active ship and starbase designs (max 16 ship + 10 starbase).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ship-design"
          }
        },
        "research": {
          "type": "object",
          "properties": {
            "budget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "weapons": {
              "type": "object",
              "properties": {
                "level": {
                  "$ref": "tech.json#/definitions/tech-level"
                },
                "resources-to-next-level": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "energy": {
              "type": "object",
              "properties": {
                "level": {
                  "$ref": "tech.json#/definitions/tech-level"
                },
                "resources-to-next-level": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "biotechnology": {
              "type": "object",
              "properties": {
                "level": {
                  "$ref": "tech.json#/definitions/tech-level"
                },
                "resources-to-next-level": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "electronics": {
              "type": "object",
              "properties": {
                "level": {
                  "$ref": "tech.json#/definitions/tech-level"
                },
                "resources-to-next-level": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "construction": {
              "type": "object",
              "properties": {
                "level": {
                  "$ref": "tech.json#/definitions/tech-level"
                },
                "resources-to-next-level": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "propulsion": {
              "type": "object",
              "properties": {
                "level": {
                  "$ref": "tech.json#/definitions/tech-level"
                },
                "resources-to-next-level": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "slot-assignment": {
      "description": "One filled hull slot in a ship design.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot-index",
        "part-id",
        "count"
      ],
      "properties": {
        "slot-index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "part-id": {
          "$ref": "tech.json#/definitions/parts-id"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "ship-design": {
      "description": "A ship or starbase design owned by the player. See docs/mechanics/ship_design.rst and response-turn-file.json (the wired per-player view).",
      "type": "object",
      "required": [
        "slot",
        "kind",
        "name",
        "hull-id",
        "slot-assignments",
        "built-count"
      ],
      "properties": {
        "slot": {
          "description": "Design slot index (ship 0-15, starbase 0-9). Production queue references a ship design as build-object-id 1024+slot.",
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "kind": {
          "enum": [
            "ship",
            "starbase"
          ]
        },
        "name": {
          "type": "string"
        },
        "hull-id": {
          "description": "ship-hull id when kind=ship, starbase-hull id when kind=starbase.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "slot-assignments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/slot-assignment"
          }
        },
        "built-count": {
          "description": "Ships of this design currently in existence; > 0 locks the slot and disables editing.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
